---
import { getCollection } from 'astro:content';

type PostEntry = {
  slug: string;
  data: {
    title: string;
    date: string;
    description: string;
  };
  render: () => Promise<{ Content: any }>;
};

export async function getStaticPaths() {
  const posts: PostEntry[] = await getCollection('posts');

  return posts.map((post: PostEntry) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: PostEntry };
const { title, date, description } = post.data;
const { Content } = await post.render();
const baseUrl = import.meta.env.BASE_URL;

const formattedDate = new Date(date).toLocaleDateString('es-AR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main class="container article">
      <article class="article-wrap">
        <div class="eyebrow">{formattedDate}</div>
        <h1>{title}</h1>
        <p class="summary">{description}</p>

        <div class="article-content">
          <Content />
        </div>

        <a href={baseUrl} class="site-link">← Volver al devlog</a>
      </article>
    </main>
  </body>
</html>

<style is:global>
  @import '../../styles/global.css';
</style>
