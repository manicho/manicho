---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';

type PostEntry = {
  slug: string;
  data: {
    title: string;
    date: string;
    description: string;
  };
};

const posts: PostEntry[] = await getCollection('posts');
const sortedPosts = posts.sort(
  (a: PostEntry, b: PostEntry) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Devlog | Mauricio</title>
    <meta name="description" content="Devlog personal de Mauricio" />
  </head>
  <body>
    <main class="container">
      <header class="hero">
        <span class="badge">Devlog</span>
        <h1>Notas de desarrollo, errores, aprendizajes y progreso.</h1>
        <p>
          Este es un espacio simple para documentar avances, decisiones técnicas y cosas
          que voy aprendiendo mientras construyo.
        </p>
      </header>

      <section class="posts">
        {sortedPosts.map((post) => {
          return (
            <PostCard
              post={{
                title: post.data.title,
                date: post.data.date,
                description: post.data.description,
                url: `/posts/${post.slug}`,
              }}
            />
          );
        })}
      </section>
    </main>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
